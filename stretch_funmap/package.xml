<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>stretch_funmap</name>
  <version>0.1.0</version>
  <description> The stretch_funmap package </description>
  <maintainer email="support@hello-robot.com">Hello Robot Inc.</maintainer>
  <license>Apache License 2.0</license>

  <depend>actionlib_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>nav2_msgs</depend>
  <depend>control_msgs</depend>
  <depend>trajectory_msgs</depend>
  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>tf2</depend>
  <depend>cython3</depend>

  <!-- Python dependencies (rosdep keys). pip-only packages use the -pip
       convention defined in rosdeps/extra-rosdeps.yaml. -->
  <depend>cma-pip</depend>
  <depend>python3-matplotlib</depend>
  <depend>python3-numba</depend>
  <depend>python3-numpy</depend>
  <depend>python3-opencv</depend>
  <depend>pyquaternion-pip</depend>
  <depend>python3-yaml</depend>
  <depend>python3-skimage</depend>
  <depend>python3-scipy</depend>
  <depend>python-transforms3d-pip</depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
